              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Task"
      }
    },
    "/api/agent/tasks/paid": {
      "post": {
        "description": "x402 surface: same task surface, payment-gated.\n\nWithout X-PAYMENT: answers HTTP 402 with an x402 `accepts` challenge\n(scheme=exact, network=bsc, USDC). If X402_PAYTO_ADDRESS is unset the\nsurface responds 501 \u2014 the challenge cannot be issued honestly without a\nsettlement address. Payment *verification* (settlement) is labeled\nPLANNED: it requires a connected payer wallet or facilitator.",
        "operationId": "submit_task_paid_api_agent_tasks_paid_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Task Paid"
      }
    },
