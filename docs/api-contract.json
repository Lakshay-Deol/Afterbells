{
  "components": {
    "schemas": {
      "ApproveIn": {
        "properties": {
          "constitution": {
            "additionalProperties": true,
            "title": "Constitution",
            "type": "object"
          },
          "nl_text": {
            "title": "Nl Text",
            "type": "string"
          }
        },
        "required": [
          "nl_text",
          "constitution"
        ],
        "title": "ApproveIn",
        "type": "object"
      },
      "CompareIn": {
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/DecisionPolicy"
          },
          "receipt": {
            "additionalProperties": true,
            "title": "Receipt",
            "type": "object"
          }
        },
        "required": [
          "receipt",
          "policy"
        ],
        "title": "CompareIn",
        "type": "object"
      },
      "CompileIn": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "CompileIn",
        "type": "object"
      },
      "DecisionBundleIn": {
        "properties": {
          "receipt": {
            "additionalProperties": true,
            "title": "Receipt",
            "type": "object"
          }
        },
        "required": [
          "receipt"
        ],
        "title": "DecisionBundleIn",
        "type": "object"
      },
      "DecisionPolicy": {
        "additionalProperties": false,
        "properties": {
          "allow_closed_market": {
            "default": true,
            "title": "Allow Closed Market",
            "type": "boolean"
          },
          "allowed_platforms": {
            "items": {
              "enum": [
                "ondo",
                "xstocks",
                "bstock"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "title": "Allowed Platforms",
            "type": "array"
          },
          "max_parity_deviation_bps": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "500",
            "title": "Max Parity Deviation Bps"
          },
          "max_premium_bps": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "100",
            "title": "Max Premium Bps"
          },
          "max_slippage_bps": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "50",
            "title": "Max Slippage Bps"
          },
          "min_liquidity_usd": {
            "anyOf": [
              {
                "maximum": 1000000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0",
            "title": "Min Liquidity Usd"
          },
          "require_attestation": {
            "default": false,
            "title": "Require Attestation",
            "type": "boolean"
          }
        },
        "title": "DecisionPolicy",
        "type": "object"
      },
      "DecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "default": "recorded",
            "enum": [
              "live",
              "recorded"
            ],
            "title": "Mode",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/DecisionPolicy"
          },
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunIn": {
        "properties": {
          "confirm": {
            "default": false,
            "title": "Confirm",
            "type": "boolean"
          },
          "intent": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "state": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "title": "RunIn",
        "type": "object"
      },
      "TaskIn": {
        "properties": {
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "kind": {
            "default": "EVALUATE_EQUITY_INTENT",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "title": "TaskIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyIn": {
        "properties": {
          "receipt": {
            "additionalProperties": true,
            "title": "Receipt",
            "type": "object"
          }
        },
        "required": [
          "receipt"
        ],
        "title": "VerifyIn",
        "type": "object"
      }
    }
  },
